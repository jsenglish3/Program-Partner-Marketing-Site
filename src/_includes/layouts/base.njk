<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set meta = seo[page.url] or {} %}
{% set title = meta.title if meta.title is defined else title %}
{% set description = meta.description if meta.description is defined else description %}
<title>{% if title %}{{ title | escape }} | Program Partner{% else %}Program Partner: a program office for performing arts{% endif %}</title>
<meta name="description" content="{{ (description or site.description) | escape }}">
{%- if noindex %}
<meta name="robots" content="noindex">
{%- endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Program Partner">
<meta property="og:title" content="{{ (title or 'Program Partner') | escape }}">
<meta property="og:description" content="{{ (description or site.description) | escape }}">
{%- set origin = shareOrigin or site.url %}
{%- set socialImage = meta.image or '/assets/share.png' %}
{%- set socialImageUrl = socialImage if (socialImage.indexOf('https://') == 0 or socialImage.indexOf('http://') == 0 or socialImage.indexOf('blob:') == 0) else origin + socialImage %}
<meta property="og:url" content="{{ origin }}{{ page.url }}">
<meta property="og:image" content="{{ socialImageUrl | escape }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ (meta.imageAlt or 'Program Partner: Stress less. Teach more. The program office for band, orchestra, choir, theatre and private studios.') | escape }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ socialImageUrl | escape }}">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/assets/fonts/urbanist-latin-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/lora-latin-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/site.css">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Organization","name":"Program Partner, LLC","url":"{{ site.url }}","logo":"{{ site.url }}/assets/logo-horizontal-color.svg","email":"{{ site.supportEmail }}","sameAs":["{{ site.facebook }}","{{ site.instagram }}"]}
</script>
</head>
<body>
{% include "partials/header.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script src="/assets/site.js" defer></script>
{%- if site.cloudflareAnalyticsToken %}
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cloudflareAnalyticsToken }}"}'></script>
{%- endif %}
</body>
</html>

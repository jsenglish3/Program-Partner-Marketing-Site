<footer class="site-footer">
<div class="inner">
<div class="cols">
<div class="about">
<a href="{{ copy["footer"].introduction.text_001 | escape }}" style="display:inline-flex;width:max-content;border-radius:6px"><img src="/assets/logo-horizontal-white.svg" alt="{{ copy["footer"].introduction.text_002 | escape }}" width="101" height="44"></a>
<p style="font-size:17px;line-height:1.5">{{ copy["footer"].introduction.text_003 | safe }}</p>
</div>
<nav aria-label="Features"><h2>{{ copy["footer"].introduction.text_004 | safe }}</h2><ul>
{%- for f in nav.features %}<li><a href="{{ f.href }}">{{ f.name }}</a></li>{% endfor %}
</ul></nav>
<nav aria-label="Who it's for"><h2>{{ copy["footer"].introduction.text_005 | safe }}</h2><ul>
{%- for w in nav.who %}<li><a href="{{ w.href }}">{{ w.name }}</a></li>{% endfor %}
</ul></nav>
<nav aria-label="Resources"><h2>{{ copy["footer"].introduction.text_006 | safe }}</h2><ul>
<li><a href="{{ copy["footer"].introduction.text_007 | escape }}">{{ copy["footer"].introduction.text_008 | safe }}</a></li>
<li><a href="{{ copy["footer"].introduction.text_009 | escape }}">{{ copy["footer"].introduction.text_010 | safe }}</a></li>
<li><a href="{{ copy["footer"].introduction.text_011 | escape }}">{{ copy["footer"].introduction.text_012 | safe }}</a></li>
</ul></nav>
<nav aria-label="Company"><h2>{{ copy["footer"].introduction.text_013 | safe }}</h2><ul>
{%- for c in nav.company %}<li><a href="{{ c.href }}">{{ c.name }}</a></li>{% endfor %}
<li><a href="{{ site.appUrl }}">{{ copy["footer"].introduction.text_014 | safe }}</a></li>
</ul></nav>
</div>
<div class="meta">
<a href="mailto:{{ site.supportEmail }}" class="mail">{{ site.supportEmail }}</a>
<a href="{{ site.facebook }}">{{ copy["footer"].introduction.text_015 | safe }}</a>
<a href="{{ site.instagram }}">{{ copy["footer"].introduction.text_016 | safe }}</a>
</div>
<div class="legal">
<a href="{{ copy["footer"].introduction.text_017 | escape }}">{{ copy["footer"].introduction.text_018 | safe }}</a><span aria-hidden="true">·</span>
<a href="{{ copy["footer"].introduction.text_019 | escape }}">{{ copy["footer"].introduction.text_020 | safe }}</a><span aria-hidden="true">·</span>
<a href="{{ copy["footer"].introduction.text_021 | escape }}">{{ copy["footer"].introduction.text_022 | safe }}</a><span aria-hidden="true">·</span>
<span>© {{ buildYear }} {{ copy["footer"].introduction.text_023 | safe }}</span>
</div>
</div>
</footer>

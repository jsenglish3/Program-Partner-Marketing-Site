{%- set cur = current or "" -%}
{%- set inFeatures = (cur == "product") -%}
{%- for f in nav.features %}{% if f.key == cur %}{% set inFeatures = true %}{% endif %}{% endfor -%}
{%- set inWho = false -%}
{%- for w in nav.who %}{% if w.key == cur %}{% set inWho = true %}{% endif %}{% endfor -%}
{%- set inRes = (cur == "security" or cur == "woodshed" or cur == "contact") -%}
{%- macro chevron() %}<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"></path></svg>{% endmacro -%}
<header class="site-header">
<a href="#main" class="skip">Skip to content</a>
<div class="header-row">
<a href="/" class="brand"><img src="/assets/logo-horizontal-color.svg" alt="Program Partner home" width="110" height="48"></a>
<nav aria-label="Main" class="nav-main">
<details name="nav" class="{% if inFeatures %}is-current{% endif %}">
<summary>Features{{ chevron() }}</summary>
<div class="menu-panel cols-2">
<ul>
{%- for f in nav.features %}
<li><a href="{{ f.href }}"{% if f.key == cur %} aria-current="page"{% endif %}>{{ f.name }}</a></li>
{%- endfor %}
</ul>
<div class="more"><a href="/product/">Every feature</a></div>
</div>
</details>
<details name="nav" class="{% if inWho %}is-current{% endif %}">
<summary>Who it's for{{ chevron() }}</summary>
<div class="menu-panel w-240"><ul>
{%- for w in nav.who %}
<li><a href="{{ w.href }}"{% if w.key == cur %} aria-current="page"{% endif %}>{{ w.name }}</a></li>
{%- endfor %}
</ul></div>
</details>
<a href="/pricing/"{% if cur == "pricing" %} aria-current="page"{% endif %}>Pricing</a>
<details name="nav" class="{% if inRes %}is-current{% endif %}">
<summary>Resources{{ chevron() }}</summary>
<div class="menu-panel w-260"><ul>
{%- for r in nav.resources %}
<li><a href="{{ r.href }}"{% if r.key == cur %} aria-current="page"{% endif %}>{{ r.name }}</a></li>
{%- endfor %}
</ul></div>
</details>
<a href="/about/"{% if cur == "about" %} aria-current="page"{% endif %}>About</a>
</nav>
<div class="header-actions">
<a href="{{ site.appUrl }}" class="login-link">Log in</a>
<a href="/demo/" class="btn btn-primary">{{ site.ctaPrimary }}</a>
<details class="mobile-menu">
<summary aria-label="Menu"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>Menu</summary>
<div class="mobile-panel">
<nav aria-label="Main">
<div><p class="group-label">Features</p><ul>
{%- for f in nav.features %}<li><a href="{{ f.href }}">{{ f.name }}</a></li>{% endfor %}
<li><a href="/product/" class="strong">Every feature</a></li></ul></div>
<div><p class="group-label">Who it's for</p><ul>
{%- for w in nav.who %}<li><a href="{{ w.href }}">{{ w.name }}</a></li>{% endfor %}</ul>
<p class="group-label" style="padding-top:20px">Resources</p><ul>
{%- for r in nav.resources %}<li><a href="{{ r.href }}">{{ r.name }}</a></li>{% endfor %}</ul></div>
<div><p class="group-label">Company</p><ul>
<li><a href="/pricing/">Pricing</a></li>
<li><a href="/about/">About</a></li>
<li><a href="{{ site.appUrl }}" class="strong">Log in</a></li>
</ul></div>
</nav>
</div>
</details>
</div>
</div>
</header>

{%- set cur = current or "" -%}
{%- set inFeatures = (cur == "product") -%}
{%- for f in nav.features %}{% if f.key == cur %}{% set inFeatures = true %}{% endif %}{% endfor -%}
{%- set inWho = false -%}
{%- for w in nav.who %}{% if w.key == cur %}{% set inWho = true %}{% endif %}{% endfor -%}
{%- set inRes = (cur == "security" or cur == "woodshed" or cur == "contact" or cur == "switching") -%}
{%- macro chevron() %}<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"></path></svg>{% endmacro -%}
<header class="site-header">
<a href="#main" class="skip">{{ copy["header"].introduction.text_001 | safe }}</a>
<div class="header-row">
<a href="{{ copy["header"].introduction.text_002 | escape }}" class="brand"><img src="/assets/logo-horizontal-color.svg" alt="{{ copy["header"].introduction.text_003 | escape }}" width="110" height="48"></a>
<nav aria-label="Main" class="nav-main">
<details name="nav" class="{% if inFeatures %}is-current{% endif %}">
<summary>{{ copy["header"].introduction.text_004 | safe }}{{ chevron() }}</summary>
<div class="menu-panel cols-2">
<ul>
{%- for f in nav.features %}
<li><a href="{{ f.href }}"{% if f.key == cur %} aria-current="page"{% endif %}>{{ f.name }}</a></li>
{%- endfor %}
</ul>
<div class="more"><a href="{{ copy["header"].introduction.text_005 | escape }}">{{ copy["header"].introduction.text_006 | safe }}</a></div>
</div>
</details>
<details name="nav" class="{% if inWho %}is-current{% endif %}">
<summary>{{ copy["header"].introduction.text_007 | safe }}{{ chevron() }}</summary>
<div class="menu-panel w-240"><ul>
{%- for w in nav.who %}
<li><a href="{{ w.href }}"{% if w.key == cur %} aria-current="page"{% endif %}>{{ w.name }}</a></li>
{%- endfor %}
</ul></div>
</details>
<a href="{{ copy["header"].introduction.text_008 | escape }}"{% if cur == "pricing" %} aria-current="page"{% endif %}>{{ copy["header"].introduction.text_009 | safe }}</a>
<details name="nav" class="{% if inRes %}is-current{% endif %}">
<summary>{{ copy["header"].introduction.text_010 | safe }}{{ chevron() }}</summary>
<div class="menu-panel w-260"><ul>
{%- for r in nav.resources %}
<li><a href="{{ r.href }}"{% if r.key == cur %} aria-current="page"{% endif %}>{{ r.name }}</a></li>
{%- endfor %}
</ul></div>
</details>
<a href="{{ copy["header"].introduction.text_011 | escape }}"{% if cur == "about" %} aria-current="page"{% endif %}>{{ copy["header"].introduction.text_012 | safe }}</a>
</nav>
<div class="header-actions">
<a href="{{ site.appUrl }}" class="login-link">{{ copy["header"].introduction.text_013 | safe }}</a>
<a href="{{ copy["header"].introduction.text_014 | escape }}" class="btn btn-primary">{{ site.ctaPrimary }}</a>
<details class="mobile-menu">
<summary aria-label="Menu"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>{{ copy["header"].introduction.text_015 | safe }}</summary>
<div class="mobile-panel">
<nav aria-label="Main">
<div><p class="group-label">{{ copy["header"].introduction.text_016 | safe }}</p><ul>
{%- for f in nav.features %}<li><a href="{{ f.href }}">{{ f.name }}</a></li>{% endfor %}
<li><a href="{{ copy["header"].introduction.text_017 | escape }}" class="strong">{{ copy["header"].introduction.text_018 | safe }}</a></li></ul></div>
<div><p class="group-label">{{ copy["header"].introduction.text_019 | safe }}</p><ul>
{%- for w in nav.who %}<li><a href="{{ w.href }}">{{ w.name }}</a></li>{% endfor %}</ul>
<p class="group-label" style="padding-top:20px">{{ copy["header"].introduction.text_020 | safe }}</p><ul>
{%- for r in nav.resources %}<li><a href="{{ r.href }}">{{ r.name }}</a></li>{% endfor %}</ul></div>
<div><p class="group-label">{{ copy["header"].introduction.text_021 | safe }}</p><ul>
<li><a href="{{ copy["header"].introduction.text_022 | escape }}">{{ copy["header"].introduction.text_023 | safe }}</a></li>
<li><a href="{{ copy["header"].introduction.text_024 | escape }}">{{ copy["header"].introduction.text_025 | safe }}</a></li>
<li><a href="{{ site.appUrl }}" class="strong">{{ copy["header"].introduction.text_026 | safe }}</a></li>
</ul></div>
</nav>
</div>
</details>
</div>
</div>
</header>

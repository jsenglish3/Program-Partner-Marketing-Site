<section class="section pw" aria-labelledby="h-pathways" data-pathways>
<div class="wrap-wide stack" style="gap:clamp(24px,3.5vw,40px)">
<div class="pw-head">
<div class="stack" style="flex:1 1 520px;min-width:0;gap:14px;max-width:760px">
<p class="eyebrow" style="color:var(--coral)">Only in Program Partner</p>
<h2 id="h-pathways" class="h2">Teaching tools that make students want to practice.</h2>
<p class="muted" style="font-size:clamp(17px,1.5vw,19px);line-height:1.6;text-wrap:pretty">Students move up through levels you define, log their practice from home, and their rankings set the class seating chart. Concert charts build from the same roster.</p>
</div>
<div class="stack" style="flex:0 1 460px;min-width:0;gap:10px">
<p id="pw-name-label" class="muted" style="font-size:14px;font-weight:600">Skill Pathways is the default. Call it whatever your program calls it:</p>
<div role="group" aria-labelledby="pw-name-label" class="pw-chips" data-pw-names>
{%- for n in ["Skill Pathways","Choir Karate","Scale Wars","Band Olympics","String Quest"] %}
<button type="button" class="chip" aria-pressed="{{ 'true' if loop.first else 'false' }}" data-name="{{ n }}">{{ n }}</button>
{%- endfor %}
</div>
</div>
</div>
<div class="stack" style="gap:14px">
<div role="tablist" aria-label="Teaching tools" class="pw-tabs" data-pw-tabs>
<button type="button" role="tab" id="pw-tab-path" aria-selected="true" aria-controls="pw-panel" tabindex="0" data-tab="path">Skill Pathways</button>
<button type="button" role="tab" id="pw-tab-practice" aria-selected="false" aria-controls="pw-panel" tabindex="-1" data-tab="practice">Practice log</button>
<button type="button" role="tab" id="pw-tab-class" aria-selected="false" aria-controls="pw-panel" tabindex="-1" data-tab="class">Class seating</button>
<button type="button" role="tab" id="pw-tab-concert" aria-selected="false" aria-controls="pw-panel" tabindex="-1" data-tab="concert">Concert seating</button>
</div>
<div role="tabpanel" id="pw-panel" aria-labelledby="pw-tab-path" class="stack" style="gap:12px">
<div class="pw-stage" role="img" aria-label="Skill Pathways: five levels with how many students have passed each, and a review queue where the director passes a video submission or asks the student to try again." data-pw-stage>
<div class="pw-canvas" aria-hidden="true" data-pw-canvas></div>
</div>
<div class="pw-foot">
<p data-pw-caption>Students submit video or audio from their phones. You pass it or send it back with a note, and their level updates on its own.</p>
<button type="button" class="btn btn-outline btn-sm" data-pw-replay>↻ Replay</button>
</div>
</div>
</div>
</div>
</section>

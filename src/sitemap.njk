---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if not p.data.noindex and p.url != "/404.html" and p.url != "/sitemap.xml" %}
<url><loc>{{ site.url }}{{ p.data.canonicalPath or p.url }}</loc>{% if p.data.lastmod %}<lastmod>{{ p.data.lastmod }}</lastmod>{% endif %}</url>
{%- endif %}{% endfor %}
</urlset>

---
layout: layouts/base.njk
pagination:
  data: audiences
  size: 1
  addAllPagesToCollections: true
  alias: a
permalink: "/{{ a.key }}/"
eleventyComputed:
  title: "{{ (a.title or a.h1) | safe }}"
  current: "{{ a.key }}"
  description: "{{ a.sub | safe }}"
---
{% import "macros.njk" as m %}
{{ m.hero({ eyebrow: a.eyebrow, title: a.h1, subhead: a.sub, primaryLabel: site.ctaPrimary, primaryHref: copy["audience"].buttons.link_01 }, site, shots) }}

{%- if a.key == "directors" %}
<section class="section" aria-labelledby="h-week">
<div class="wrap stack" style="max-width:1000px;gap:clamp(28px,4vw,44px)">
<h2 id="h-week" class="h2-sm">{{ copy["audience"].week.text_001 | safe }}</h2>
<ol style="list-style:none;margin:0;padding:0;border-top:1px solid var(--border)">
{%- for w in [["Monday",copy["audience"].week.text_002],["Tuesday",copy["audience"].week.text_003],["Wednesday",copy["audience"].week.text_004],["Thursday",copy["audience"].week.text_005],["Friday",copy["audience"].week.text_006]] %}
<li style="display:grid;grid-template-columns:minmax(110px,180px) minmax(0,1fr);gap:8px 32px;align-items:baseline;padding:clamp(20px,2.6vw,28px) 0;border-bottom:1px solid var(--border)">
<span class="font-heading" style="font-size:clamp(24px,2.6vw,30px);line-height:1.2">{{ w[0] }}</span>
<span class="body-lg">{{ w[1] }}</span>
</li>
{%- endfor %}
</ol>
</div>
</section>

{%- elif a.key == "boosters" %}
<section class="section" aria-labelledby="h-report">
<div class="wrap" style="display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,64px);align-items:flex-start">
<div class="stack" style="flex:1 1 300px;min-width:0;max-width:420px;gap:16px">
<h2 id="h-report" class="h2-sm">{{ copy["audience"].report.text_007 | safe }}</h2>
<p class="body-lg muted">{{ copy["audience"].report.text_008 | safe }}</p>
</div>
<div class="card card-shadow" style="flex:2 1 520px;min-width:0;gap:28px">
<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;gap:12px">
<div class="stack" style="gap:4px"><span class="font-heading" style="font-size:24px;line-height:1.2">{{ copy["audience"].report.text_009 | safe }}</span><span class="muted" style="font-size:15px">{{ copy["audience"].report.text_010 | safe }}</span></div>
<span class="pill pill-accent">{{ copy["audience"].report.text_011 | safe }}</span>
</div>
<div class="stack" style="gap:10px">
<span class="muted" style="font-size:14px;font-weight:600">{{ copy["audience"].report.text_012 | safe }}</span>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr));gap:12px">
{%- for l in [[copy["audience"].report.text_013,"$4,000"],[copy["audience"].report.text_014,"$12,000"],["Concessions","$1,500"]] %}
<div class="stack" style="background:var(--bg);border-radius:12px;padding:16px;gap:4px"><span class="muted" style="font-size:14px">{{ l[0] }}</span><span class="font-heading tabular-nums" style="font-size:28px;line-height:1.1">{{ l[1] }}</span></div>
{%- endfor %}
</div>
</div>
<div class="stack" style="gap:12px">
<span class="muted" style="font-size:14px;font-weight:600">{{ copy["audience"].report.text_015 | safe }}</span>
{%- for b in [[copy["audience"].report.text_016,"$2,000","$5,000",40],["Uniforms","$1,000","$3,000",33],[copy["audience"].report.text_017,"$5,000","$12,000",42]] %}
<div class="stack" style="gap:6px"><div style="display:flex;justify-content:space-between;gap:12px;font-size:16px"><span style="font-weight:500">{{ b[0] }}</span><span class="muted tabular-nums">{{ b[1] }} {{ copy["audience"].report.text_018 | safe }} {{ b[2] }}</span></div><div style="height:8px;border-radius:99px;background:var(--sand);overflow:hidden"><div style="height:100%;width:{{ b[3] }}%;background:var(--primary)"></div></div></div>
{%- endfor %}
</div>
<div class="stack" style="gap:10px">
<div style="display:flex;justify-content:space-between;gap:12px"><span class="muted" style="font-size:14px;font-weight:600">{{ copy["audience"].report.text_019 | safe }}</span><span style="font-size:14px;font-weight:600">3 · $150</span></div>
<div class="stack" style="border-top:1px solid var(--sand)">
{%- for r in [[copy["audience"].report.text_020,"Cash","$50"],[copy["audience"].report.text_021,"Check","$75"],[copy["audience"].report.text_022,"Venmo","$25"]] %}
<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px 16px;padding:12px 0;border-bottom:1px solid var(--sand);font-size:16px"><span><span style="font-weight:500">{{ r[0] }}</span><span class="muted"> · {{ r[1] }}</span></span><span style="display:flex;align-items:center;gap:12px"><span class="tabular-nums">{{ r[2] }}</span><span style="font-size:14px;font-weight:600;padding:6px 12px;border-radius:8px;border:1.5px solid var(--fg)">{{ copy["audience"].report.text_023 | safe }}</span></span></div>
{%- endfor %}
</div>
</div>
</div>
</div>
</section>

{%- elif a.key == "schools" %}
<section class="section" aria-labelledby="h-packet">
<div class="wrap" style="display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,64px);align-items:flex-start">
<div class="stack" style="flex:1 1 300px;min-width:0;max-width:420px;gap:16px">
<h2 id="h-packet" class="h2-sm">{{ copy["audience"].packet.text_024 | safe }}</h2>
<p class="body-lg muted">{{ copy["audience"].packet.text_025 | safe }} <a href="{{ copy["audience"].packet.text_026 | escape }}">{{ copy["audience"].packet.text_027 | safe }}</a> {{ copy["audience"].packet.text_028 | safe }}</p>
<p class="body-lg muted">{{ copy["audience"].packet.text_029 | safe }}</p>
</div>
<article aria-label="For your approval packet" class="card card-shadow" style="flex:2 1 520px;min-width:0;border-radius:6px;padding:clamp(28px,4vw,52px);gap:24px">
<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;gap:12px;padding-bottom:18px;border-bottom:2px solid var(--fg)">
<div class="stack" style="gap:4px"><span class="font-heading" style="font-size:clamp(24px,2.8vw,32px);line-height:1.15">{{ copy["audience"].packet.text_030 | safe }}</span><span class="muted" style="font-size:15px">{{ copy["audience"].packet.text_031 | safe }}</span></div>
<span class="pill pill-accent">{{ copy["audience"].packet.text_032 | safe }}</span>
</div>
<dl style="margin:0;display:flex;flex-direction:column">
{%- for p in [[copy["audience"].packet.text_033,copy["audience"].packet.text_034],[copy["audience"].packet.text_035,copy["audience"].packet.text_036],[copy["audience"].packet.text_037,copy["audience"].packet.text_038],[copy["audience"].packet.text_039,copy["audience"].packet.text_040],[copy["audience"].packet.text_041,copy["audience"].packet.text_042]] %}
<div style="display:flex;flex-wrap:wrap;gap:6px 28px;padding:16px 0;border-bottom:1px solid var(--sand)"><dt style="flex:0 0 200px;font-weight:600;font-size:16px;line-height:1.45">{{ p[0] }}</dt><dd style="flex:1 1 200px;min-width:0;margin:0;font-size:16px;line-height:1.55">{{ p[1] }}</dd></div>
{%- endfor %}
</dl>
</article>
</div>
</section>

{%- elif a.key == "studios" %}
<section class="section" aria-labelledby="h-day">
<div class="wrap" style="display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,64px);align-items:flex-start">
<div class="stack" style="flex:1 1 300px;min-width:0;max-width:420px;gap:16px">
<h2 id="h-day" class="h2-sm">{{ copy["audience"].day.text_043 | safe }}</h2>
<p class="body-lg muted">{{ copy["audience"].day.text_044 | safe }}</p>
</div>
<div class="card card-shadow" style="flex:2 1 520px;min-width:0;gap:22px">
<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;gap:12px">
<div class="stack" style="gap:4px"><span class="font-heading" style="font-size:24px;line-height:1.2">{{ copy["audience"].day.text_045 | safe }}</span><span class="muted" style="font-size:15px">{{ copy["audience"].day.text_046 | safe }}</span></div>
<span class="pill pill-accent">{{ copy["audience"].day.text_047 | safe }}</span>
</div>
<div class="stack" style="border-top:1px solid var(--sand)">
{%- for l in [["3:30",copy["audience"].day.text_048,copy["audience"].day.text_049,copy["audience"].day.text_050,"pill-ok"],["4:15",copy["audience"].day.text_051,copy["audience"].day.text_052,"Makeup","pill-accent"],["5:15",copy["audience"].day.text_053,copy["audience"].day.text_054,"Paid","pill-sand"]] %}
<div style="display:grid;grid-template-columns:72px minmax(0,1fr) auto;gap:16px;align-items:center;padding:14px 0;border-bottom:1px solid var(--sand)"><span style="font-size:16px;font-weight:600">{{ l[0] }}</span><span class="stack" style="gap:2px"><span style="font-size:16px;font-weight:500">{{ l[1] }}</span><span class="muted" style="font-size:14px">{{ l[2] }}</span></span><span class="pill {{ l[4] }}">{{ l[3] }}</span></div>
{%- endfor %}
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px">
<div class="stack" style="background:var(--bg);border-radius:12px;padding:16px 18px;gap:6px"><span class="muted" style="font-size:14px;font-weight:600">{{ copy["audience"].day.text_055 | safe }}</span><span style="font-size:16px;line-height:1.5">{{ copy["audience"].day.text_056 | safe }}</span></div>
<div class="stack" style="background:var(--sand);border-radius:12px;padding:16px 18px;gap:6px"><span class="muted" style="font-size:14px;font-weight:600">{{ copy["audience"].day.text_057 | safe }}</span><span style="font-size:16px;line-height:1.5">{{ copy["audience"].day.text_058 | safe }}</span></div>
</div>
</div>
</div>
</section>
{%- endif %}

{%- if a.faq %}{{ m.faq(a.faqH, a.faq, "sand", "h-faq") }}{% endif %}
{{ m.cta(a.cta, a.ctaLabel or site.ctaPrimary, a.ctaHref or copy["audience"].buttons.link_02) }}

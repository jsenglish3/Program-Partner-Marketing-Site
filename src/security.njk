</section>
{%- endfor %}
<section aria-labelledby="dpa" class="card card-sand" style="margin:12px 0 36px;align-items:flex-start">
<h2 id="dpa" style="font-size:clamp(26px,3vw,34px);line-height:1.15;scroll-margin-top:96px">Request our data privacy agreement</h2>
<p style="font-size:18px;line-height:1.6">Send us your district's name and, if you have one, the agreement your district already uses. We'll reply within one business day with ours, or with our questions about yours.</p>
<a href="mailto:{{ site.supportEmail }}?subject=Data%20privacy%20agreement%20request" class="btn btn-primary">Request the agreement</a>
</section>

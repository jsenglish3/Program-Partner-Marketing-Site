---
layout: layouts/base.njk
current: security
title: Security and privacy
permalink: /security/
description: "What Program Partner stores, who can see it, how it's protected, and what we will never do with student information."
---
{% import "macros.njk" as m %}
{%- set sections = [
  { id: "store", h: copy["security"].introduction.text_001, p: copy["security"].introduction.text_002 },
  { id: "see", h: copy["security"].introduction.text_003, items: [copy["security"].introduction.text_004, copy["security"].introduction.text_005, copy["security"].introduction.text_006] },
  { id: "protect", h: copy["security"].introduction.text_007, items: [copy["security"].introduction.text_008, copy["security"].introduction.text_009, copy["security"].introduction.text_010, copy["security"].introduction.text_011, copy["security"].introduction.text_012] },
  { id: "payments", h: "Payments", p: copy["security"].introduction.text_013 },
  { id: "never", h: copy["security"].introduction.text_014, items: [copy["security"].introduction.text_015, copy["security"].introduction.text_016, copy["security"].introduction.text_017] },
  { id: "law", h: copy["security"].introduction.text_018, items: [copy["security"].introduction.text_019, copy["security"].introduction.text_020, copy["security"].introduction.text_021] },
  { id: "rights", h: copy["security"].introduction.text_022, items: [copy["security"].introduction.text_023, copy["security"].introduction.text_024, copy["security"].introduction.text_025] }
] -%}
{{ m.hero({ title: copy["security"].introduction.text_026, subhead: copy["security"].introduction.text_027 }, site, shots) }}
<div style="padding:0 0 var(--section-y)">
<div class="wrap" style="display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,72px);align-items:flex-start">
<nav aria-label="On this page" class="toc">
<p class="muted" style="margin-bottom:10px;font-size:14px;font-weight:600">{{ copy["security"].introduction.text_028 | safe }}</p>
<ol>
{%- for s in sections %}<li><a href="#{{ s.id }}">{{ s.h }}</a></li>{% endfor %}
<li><a href="#dpa">{{ copy["security"].introduction.text_029 | safe }}</a></li>
</ol>
</nav>
<div class="stack" style="flex:3 1 480px;min-width:0;max-width:760px">
{%- for s in sections %}
<section aria-labelledby="{{ s.id }}" class="stack" style="padding:36px 0;border-top:1px solid var(--border);gap:14px;scroll-margin-top:88px">
<h2 id="{{ s.id }}" style="font-size:clamp(26px,3vw,34px);line-height:1.15;scroll-margin-top:96px">{{ s.h }}</h2>
{%- if s.p %}<p style="font-size:18px;line-height:1.65">{{ s.p }}</p>{% endif %}
{%- if s.items %}<ul class="bullets">{% for it in s.items %}<li><span class="dot" aria-hidden="true"></span><span>{{ it }}</span></li>{% endfor %}</ul>{% endif %}
</section>
{%- endfor %}
<section aria-labelledby="dpa" class="card card-sand" style="margin:12px 0 36px;align-items:flex-start">
<h2 id="dpa" style="font-size:clamp(26px,3vw,34px);line-height:1.15;scroll-margin-top:96px">{{ copy["security"].dpa.text_030 | safe }}</h2>
<p style="font-size:18px;line-height:1.6">{{ copy["security"].dpa.text_031 | safe }}</p>
<a href="mailto:{{ site.supportEmail }}?subject=Data%20privacy%20agreement%20request" class="btn btn-primary">{{ copy["security"].dpa.text_032 | safe }}</a>
</section>
<section aria-labelledby="h-q" class="stack" style="padding:36px 0;border-top:1px solid var(--border);gap:14px">
<h2 id="h-q" style="font-size:clamp(26px,3vw,34px)">{{ copy["security"].q.text_033 | safe }}</h2>
<p style="font-size:18px"><a href="mailto:{{ site.supportEmail }}" style="font-weight:600">{{ site.supportEmail }}</a></p>
</section>
</div>
</div>
</div>

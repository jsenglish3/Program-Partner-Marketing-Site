---
layout: layouts/base.njk
current: about
title: About
permalink: /about/
description: "Program Partner started as one band director's answer to the paperwork that ate his planning periods. Built by a director, for directors and teachers."
---
{% import "macros.njk" as m %}
{{ m.hero({ title: copy["about"].introduction.text_001, subhead: copy["about"].introduction.text_002 }, site, shots) }}
<section aria-labelledby="h-story" style="padding:0 0 var(--section-y)">
<div class="wrap" style="display:flex;flex-wrap:wrap;gap:clamp(28px,5vw,64px);align-items:stretch">
<figure class="stack" style="flex:1 1 280px;max-width:400px;margin:0;align-self:flex-start;gap:12px">
{%- if hasFounderPhoto %}
<img src="{{ copy["about"].story.text_003 | escape }}" alt="{{ copy["about"].story.text_004 | escape }}" style="width:100%;aspect-ratio:2/3;object-fit:cover;object-position:center 30%;border-radius:16px">
{%- else %}
<div role="img" aria-label="Trey English, founder of Program Partner (photo coming)" style="width:100%;aspect-ratio:2/3;border-radius:16px;background:var(--sand)"></div>
{%- endif %}
<figcaption class="muted" style="font-size:15px">{{ copy["about"].story.text_005 | safe }}</figcaption>
</figure>
<div class="stack" style="flex:2 1 420px;min-width:0;gap:16px">
<h2 id="h-story" class="h2-sm">{{ copy["about"].story.text_006 | safe }}</h2>
<div class="stack" style="max-width:680px;gap:20px;font-size:18px;line-height:1.65;text-wrap:pretty">
<p>{{ copy["about"].story.text_007 | safe }}</p>
<p>{{ copy["about"].story.text_008 | safe }}</p>
<p>{{ copy["about"].story.text_009 | safe }}</p>
<p>{{ copy["about"].story.text_010 | safe }}</p>
<p>{{ copy["about"].story.text_011 | safe }}</p>
<p>{{ copy["about"].story.text_012 | safe }} <a href="{{ copy["about"].story.text_013 | escape }}">{{ copy["about"].story.text_014 | safe }}</a>{{ copy["about"].story.text_015 | safe }}</p>
<p class="serif" style="font-size:clamp(22px,2.4vw,26px);line-height:1.4">{{ copy["about"].story.text_016 | safe }}</p>
<p style="font-size:16px;font-weight:600">{{ copy["about"].story.text_017 | safe }}</p>
</div>
</div>
</div>
</section>
<section class="section band-dark" aria-labelledby="h-believe">
<div class="wrap stack" style="gap:clamp(32px,5vw,56px)">
<h2 id="h-believe" class="h2">{{ copy["about"].believe.text_018 | safe }}</h2>
<ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:32px">
{%- for b in [copy["about"].believe.text_019, copy["about"].believe.text_020, copy["about"].believe.text_021] %}
<li class="serif" style="border-top:1px solid rgb(255 255 255 / .2);padding-top:20px;font-size:24px;line-height:1.35">{{ b }}</li>
{%- endfor %}
</ul>
</div>
</section>
<section class="section" aria-label="Company">
<div class="wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:40px 64px">
<div class="stack" style="gap:12px"><h2 style="font-size:32px">{{ copy["about"].company.text_022 | safe }}</h2>
<ul style="list-style:none;margin:0;padding:0;font-size:18px;line-height:1.8"><li>{{ copy["about"].company.text_023 | safe }}</li><li><a href="mailto:{{ site.supportEmail }}">{{ site.supportEmail }}</a></li><li style="display:flex;gap:20px"><a href="{{ site.facebook }}">{{ copy["about"].company.text_024 | safe }}</a><a href="{{ site.instagram }}">{{ copy["about"].company.text_025 | safe }}</a></li></ul></div>
</div>
</section>
{{ m.cta(copy["about"].company.text_026, site.ctaPrimary, copy["about"].buttons.link_01) }}
